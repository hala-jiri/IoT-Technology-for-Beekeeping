@model BeeApp.Shared.DTO.FeedingEventCreateDto
@{
    ViewData["Title"] = "Upravit krmení";
    var seasonYear = (int)ViewBag.SeasonYear;
    var hiveName = (string)ViewBag.HiveName;
}

<h2>@ViewData["Title"] – @hiveName</h2>

<form asp-action="Edit" asp-controller="Feeding" asp-route-id="@Context.Request.RouteValues["id"]" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="seasonYear" value="@seasonYear" />
    <input type="hidden" asp-for="HiveId" />

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Date" class="form-label">Datum</label>
            <input asp-for="Date" type="date" class="form-control" />
            <span class="text-danger" asp-validation-for="Date"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Medium" class="form-label">Typ</label>
            <select asp-for="Medium" class="form-select" id="medium">
                <option value="0">Sirup</option>
                <option value="1">Těsto</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Quantity" class="form-label">Množství</label>
            <input asp-for="Quantity" class="form-control" step="0.1" />
            <span class="text-danger" asp-validation-for="Quantity"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Jednotka</label>
            <input id="unitDisp" class="form-control" disabled />
            <input type="hidden" asp-for="Unit" id="UnitHidden" />
        </div>

        <div class="col-md-3">
            <label asp-for="SyrupRatio" class="form-label">Poměr (sirup)</label>
            <input asp-for="SyrupRatio" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Additives" class="form-label">Přísady</label>
            <input asp-for="Additives" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Note" class="form-label">Poznámka</label>
            <input asp-for="Note" class="form-control" />
        </div>

        <div class="col-auto">
            <button class="btn btn-primary" type="submit">Uložit</button>
            <a asp-controller="Feeding" asp-action="Hive" asp-route-hiveId="@Model.HiveId" asp-route-seasonYear="@seasonYear" class="btn btn-secondary">Zpět</a>
        </div>
    </div>
</form>

@* TODO: NOT MY CODE, GENERATED BY AI*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setUnit() {
            const m = document.getElementById('medium').value;
            const disp = document.getElementById('unitDisp');
            const hid = document.getElementById('UnitHidden');
            if (m === '0') { disp.value = 'L'; hid.value = '0'; }
            else { disp.value = 'g'; hid.value = '1'; }
        }
        document.getElementById('medium').addEventListener('change', setUnit);
        setUnit();
    </script>
}