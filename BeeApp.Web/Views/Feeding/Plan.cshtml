@model BeeApp.Shared.DTO.FeedingPlanUpsertDto
@{
    ViewData["Title"] = "Cíl krmení";
    var hiveName = (string)ViewBag.HiveName;
}
<h2>@ViewData["Title"] – @hiveName (@Model.SeasonYear)</h2>

<form asp-action="PlanSave" asp-controller="Feeding" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="HiveId" />
    <input type="hidden" asp-for="SeasonYear" />

    <div class="col-md-3">
        <label class="form-label">Sirup (L)</label>
        <input asp-for="TargetSyrupLiters" class="form-control" type="number" step="0.1" />
        <span class="text-danger" asp-validation-for="TargetSyrupLiters"></span>
    </div>
    <div class="col-md-3">
        <label class="form-label">Těsto (g)</label>
        <input asp-for="TargetPattyGrams" class="form-control" type="number" step="1" />
        <span class="text-danger" asp-validation-for="TargetPattyGrams"></span>
    </div>

    <div class="col-md-3">
        <label class="form-label">Od</label>
        <input asp-for="From" class="form-control" type="date" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Do</label>
        <input asp-for="To" class="form-control" type="date" />
    </div>

    <div class="col-12">
        <button class="btn btn-primary">Uložit</button>
        <a class="btn btn-secondary"
           asp-controller="Feeding" asp-action="Hive"
           asp-route-hiveId="@Model.HiveId" asp-route-seasonYear="@Model.SeasonYear">Zpět</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}