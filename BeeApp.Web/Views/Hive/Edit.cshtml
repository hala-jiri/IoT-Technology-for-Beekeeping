@model BeeApp.Shared.DTO.HiveUpdateDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Edit Hive";
    var apiaries = (ViewBag.Apiaries as List<BeeApp.Shared.Models.Apiary>) ?? new();
}

<style>
    .subtitle {
        color: #6c757d;
        font-size: .9rem;
    }

    .card-clean {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }
</style>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">Edit hive</h2>
        <div class="subtitle">ID: @Model.HiveId</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-apiaryId="@Model.ApiaryId" class="btn btn-outline-primary">← Back to hives</a>
    </div>
</div>

<div class="card card-clean">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="HiveId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-12 col-md-6">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Hive A1" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="ApiaryId" class="form-label">Apiary</label>
                <select asp-for="ApiaryId"
                        class="form-select"
                        asp-items="@(new SelectList(apiaries, "ApiaryId", "Name", Model.ApiaryId))">
                    <option value="">-- choose apiary --</option>
                </select>
                <span class="subtitle">Changing the apiary will move this hive.</span>
                <span asp-validation-for="ApiaryId" class="text-danger"></span>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" asp-route-apiaryId="@Model.ApiaryId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}