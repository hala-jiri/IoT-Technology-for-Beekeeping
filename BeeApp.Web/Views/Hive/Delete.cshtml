@model BeeApp.Shared.Models.Hive

@{
    ViewData["Title"] = "Delete Hive";
}

<style>
    .subtitle {
        color: #6c757d;
        font-size: .9rem;
    }

    .card-clean {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }
</style>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">⚠️ Confirm delete</h2>
        <div class="subtitle">This action cannot be undone.</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-apiaryId="@Model.ApiaryId" class="btn btn-outline-primary">← Back to hives</a>
    </div>
</div>

<div class="alert alert-danger">
    Are you sure you want to delete hive <strong>@Model.Name</strong>?
</div>

<div class="card card-clean">
    <div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-3">Hive name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Apiary ID</dt>
            <dd class="col-sm-9">@Model.ApiaryId</dd>
        </dl>

        <form asp-action="DeleteConfirmed" method="post" class="d-flex flex-column gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="HiveId" />

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="confirmCheck" />
                <label class="form-check-label" for="confirmCheck">
                    I understand that this will permanently remove the hive and its related data.
                </label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger" id="deleteBtn" disabled>Yes, delete</button>
                <a asp-action="Index" asp-route-apiaryId="@Model.ApiaryId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Enable "Delete" only after explicit confirmation
        document.getElementById('confirmCheck')?.addEventListener('change', function () {
            document.getElementById('deleteBtn').disabled = !this.checked;
        });
    </script>
}