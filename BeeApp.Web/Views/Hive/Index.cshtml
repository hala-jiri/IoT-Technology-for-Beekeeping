@model List<BeeApp.Shared.ViewModels.HiveViewModel>

<h1>Hives under apiary: @Model.FirstOrDefault()?.ApiaryName</h1>

<p>
    <a asp-action="Create" asp-route-apiaryId="@Model.FirstOrDefault()?.ApiaryId" class="btn btn-success">➕ Add hive</a>
</p>

@if (ViewBag.Lat != null && ViewBag.Lng != null || !string.IsNullOrEmpty(ViewBag.ApiaryImage))
{
    <div class="d-flex gap-4 align-items-start mb-4">
        @if (!string.IsNullOrEmpty(ViewBag.ApiaryImage))
        {
            <div style="height: 300px; width: auto;">
                <img src="~/uploads/apiaries/@ViewBag.ApiaryImage"
                     class="rounded shadow"
                     style="height: 100%; width: auto; object-fit: cover;" />
            </div>
        }

        @if (ViewBag.Lat != null && ViewBag.Lng != null)
        {
            <div id="apiary-map"
                 style="height: 300px; width: 100%; max-width: 500px;"
                 class="flex-shrink-0 rounded shadow"></div>
        }
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Hive name</th>
            <th>Last measurement</th>
            <th>Weight (kg)</th>
            <th>Temperature (°C)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hive in Model)
        {
            <tr>
                <td>@hive.Name</td>
                <td>@(hive.LastMeasurement?.ToString("g") ?? "–")</td>
                <td>@(hive.LastWeight?.ToString("F1") ?? "–")</td>
                <td>@(hive.LastTemperature?.ToString("F1") ?? "–")</td>
                <td>
                    <a asp-action="Detail" asp-route-id="@hive.HiveId" class="btn btn-link">🔍 Detail</a>
                    <a asp-action="Edit" asp-route-id="@hive.HiveId">✏️ Edit</a>
                    <a asp-action="Delete" asp-route-id="@hive.HiveId" class="text-danger">🗑️ Delete</a>

                </td>
            </tr>
        }
    </tbody>
</table>

@* TODO: NOT MY CODE, GENERATED BY AI  - ADD JS*@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.3/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const lat = parseFloat("@ViewBag.Lat".replace(',', '.'));
        const lng = parseFloat("@ViewBag.Lng".replace(',', '.'));

        if (!isNaN(lat) && !isNaN(lng)) {
            const map = L.map("apiary-map").setView([lat, lng], 12);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);
            L.marker([lat, lng]).addTo(map);

            setTimeout(() => map.invalidateSize(), 300); // 💡 fix pro šedou mapu
        }
    });
</script>
