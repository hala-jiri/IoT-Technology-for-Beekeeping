@model BeeApp.Shared.DTO.HiveCreateDto

@{
    ViewData["Title"] = "Add Hive";
}

<style>
    .subtitle {
        color: #6c757d;
        font-size: .9rem;
    }

    .card-clean {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }
</style>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">Add hive</h2>
        <div class="subtitle">Apiary ID: @Model.ApiaryId</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-apiaryId="@Model.ApiaryId" class="btn btn-outline-primary">← Back to hives</a>
    </div>
</div>

<div class="card card-clean">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ApiaryId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-12 col-md-6">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Hive A1" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" asp-route-apiaryId="@Model.ApiaryId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}