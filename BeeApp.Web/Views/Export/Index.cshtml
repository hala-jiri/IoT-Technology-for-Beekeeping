@model BeeApp.Shared.ViewModels.ExportDataRequestViewModel

@{
    ViewData["Title"] = "Export Data";
    var anyApiaries = Model?.AvailableApiaries != null && Model.AvailableApiaries.Any();
}

<style>
    .subtitle {
        color: #6c757d;
        font-size: .9rem;
    }

    .card-clean {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .apiary-card .card-header {
        background: #fff;
    }

    .badge-soft {
        border: 1px solid rgba(0,0,0,.08);
        background: #f8f9fa;
    }
</style>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">📤 Export Data</h2>
        <div class="subtitle">Choose hives, set date range and data types, then export CSV (ZIP) or JSON.</div>
    </div>
</div>

@if (!anyApiaries)
{
    <div class="alert alert-info">No apiaries or hives available to export.</div>
}
else
{
    <form method="post">
        @Html.AntiForgeryToken()

        <!-- Toolbar -->
        <div class="card card-clean mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="subtitle">Quick range:</span>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-range="7">Last 7 days</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-range="30">Last 30 days</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-range="0">Today</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="clearRange">Clear</button>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0">From</label>
                    <input asp-for="From" type="date" class="form-control form-control-sm w-auto" />
                    <label class="form-label mb-0">To</label>
                    <input asp-for="To" type="date" class="form-control form-control-sm w-auto" />
                </div>

                <div class="vr"></div>

                <div class="form-check">
                    <input type="checkbox" asp-for="IncludeMeasurements" class="form-check-input" id="incMeas" />
                    <label class="form-check-label" for="incMeas">Measurements</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" asp-for="IncludeInspections" class="form-check-input" id="incInsp" />
                    <label class="form-check-label" for="incInsp">Inspections</label>
                </div>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="selectAll">Select all hives</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="deselectAll">Deselect all</button>
                    <span class="badge badge-soft rounded-pill px-3" id="selectionBadge">Selected: 0</span>
                </div>
            </div>
        </div>

        <!-- Apiaries & hives -->
        <div class="row g-3">
            @foreach (var apiary in Model.AvailableApiaries)
            {
                var total = apiary.Hives?.Count ?? 0;
                <div class="col-12">
                    <div class="card apiary-card card-clean">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="mb-0">@apiary.Name</h5>
                                <span class="badge text-bg-primary" id="badge-@apiary.ApiaryId">0 / @total selected</span>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="selectHives(@apiary.ApiaryId, true)">Select all</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectHives(@apiary.ApiaryId, false)">Deselect</button>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (total == 0)
                            {
                                <div class="subtitle">No hives in this apiary.</div>
                            }
                            else
                            {
                                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-2">
                                    @foreach (var hive in apiary.Hives)
                                    {
                                        <div class="col">
                                            <div class="form-check">
                                                <input class="form-check-input hive-checkbox apiary-@apiary.ApiaryId"
                                                       type="checkbox"
                                                       name="SelectedHiveIds"
                                                       value="@hive.HiveId"
                                                       checked />
                                                <label class="form-check-label">@hive.Name</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" formaction="/Export/ExportCsv" class="btn btn-primary" id="exportCsvBtn">📥 Export CSV (ZIP)</button>
            <button type="submit" formaction="/Export/ExportJson" class="btn btn-secondary" id="exportJsonBtn">📄 Export JSON</button>
            <span class="subtitle">Exports only selected hives and selected data types within the date range (if any).</span>
        </div>
    </form>
}

@section Scripts {
    <script>
        // Utilities
        function ymd(d) {
            // yyyy-MM-dd in local time
            const pad = n => n.toString().padStart(2, '0');
            return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
        }

        // Select/Deselect in one apiary
        function selectHives(apiaryId, check) {
            document.querySelectorAll('.apiary-' + apiaryId).forEach(c => { c.checked = check; });
            updateCounts();
        }

        // Global handlers
        const selectAllBtn = document.getElementById('selectAll');
        const deselectAllBtn = document.getElementById('deselectAll');
        const selectionBadge = document.getElementById('selectionBadge');

        selectAllBtn?.addEventListener('click', () => {
            document.querySelectorAll('.hive-checkbox').forEach(c => c.checked = true);
            updateCounts();
        });
        deselectAllBtn?.addEventListener('click', () => {
            document.querySelectorAll('.hive-checkbox').forEach(c => c.checked = false);
            updateCounts();
        });

        // Quick ranges
        document.querySelectorAll('[data-range]').forEach(btn => {
            btn.addEventListener('click', () => {
                const days = parseInt(btn.getAttribute('data-range'), 10);
                const to = new Date(); // today
                const from = new Date();
                if (days === 0) {
                    // today only
                    document.getElementById('From').value = ymd(to);
                    document.getElementById('To').value   = ymd(to);
                } else {
                    from.setDate(to.getDate() - days);
                    document.getElementById('From').value = ymd(from);
                    document.getElementById('To').value   = ymd(to);
                }
            });
        });
        document.getElementById('clearRange')?.addEventListener('click', () => {
            document.getElementById('From').value = '';
            document.getElementById('To').value   = '';
        });

        // Count badges
        function updateCounts() {
            let totalSelected = 0;
            // per apiary
            document.querySelectorAll('[id^="badge-"]').forEach(badge => {
                const apiaryId = badge.id.split('-')[1];
                const boxes = document.querySelectorAll('.apiary-' + apiaryId);
                let sel = 0, all = 0;
                boxes.forEach(cb => { all++; if (cb.checked) sel++; });
                badge.textContent = `${sel} / ${all} selected`;
                totalSelected += sel;
            });
            // total
            selectionBadge.textContent = `Selected: ${totalSelected}`;
            const canExport = totalSelected > 0 && (document.getElementById('incMeas').checked || document.getElementById('incInsp').checked);
            document.getElementById('exportCsvBtn').disabled = !canExport;
            document.getElementById('exportJsonBtn').disabled = !canExport;
        }

        // React to checks
        document.querySelectorAll('.hive-checkbox').forEach(cb => cb.addEventListener('change', updateCounts));
        document.getElementById('incMeas')?.addEventListener('change', updateCounts);
        document.getElementById('incInsp')?.addEventListener('change', updateCounts);

        // Initial
        updateCounts();

        // Guard before submit (at least one hive & one data type)
        document.querySelectorAll('button[formaction]').forEach(btn => {
            btn.closest('form')?.addEventListener('submit', function(e) {
                const anyHive = Array.from(document.querySelectorAll('.hive-checkbox')).some(cb => cb.checked);
                const anyType = document.getElementById('incMeas').checked || document.getElementById('incInsp').checked;
                if (!anyHive || !anyType) {
                    e.preventDefault();
                    alert('Please select at least one hive and at least one data type.');
                }
            }, { once: true }); // each render
        });
    </script>
}
