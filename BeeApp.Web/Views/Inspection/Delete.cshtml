@model BeeApp.Shared.Models.InspectionReport

@{
    ViewData["Title"] = "Delete Inspection";
    string Tri(bool? v) => v == true ? "Yes ✅" : v == false ? "No ❌" : "Not checked —";
}

<style>
    .subtitle {
        color: #6c757d;
        font-size: .9rem;
    }

    .card-clean {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }
</style>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">❌ Confirm deletion</h2>
        <div class="subtitle">This action cannot be undone.</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-hiveId="@Model.HiveId" class="btn btn-outline-primary">← Back to inspections</a>
        <a asp-controller="Hive" asp-action="Detail" asp-route-id="@Model.HiveId" class="btn btn-outline-secondary">🐝 Hive detail</a>
    </div>
</div>

<div class="alert alert-warning">
    Are you sure you want to delete the inspection from <strong>@Model.InspectionDate.ToString("yyyy-MM-dd HH:mm")</strong>?
</div>

<div class="card card-clean mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Queen seen</dt>
            <dd class="col-sm-9">@Tri(Model.QueenSeen)</dd>

            <dt class="col-sm-3">Brood present</dt>
            <dd class="col-sm-9">@Tri(Model.BroodPresent)</dd>

            <dt class="col-sm-3">Eggs present</dt>
            <dd class="col-sm-9">@Tri(Model.EggsPresent)</dd>

            <dt class="col-sm-3">Pollen present</dt>
            <dd class="col-sm-9">@Tri(Model.PollenPresent)</dd>

            <dt class="col-sm-3">Honey present</dt>
            <dd class="col-sm-9">@Tri(Model.HoneyPresent)</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">@Model.Notes</dd>
            }
        </dl>
    </div>
</div>

<div class="card card-clean">
    <div class="card-body">
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.InspectionReportId" method="post" class="d-flex flex-column gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="InspectionReportId" />

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="confirmCheck" />
                <label class="form-check-label" for="confirmCheck">
                    I understand this will permanently delete the inspection.
                </label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger" id="deleteBtn" disabled>Yes, delete</button>
                <a asp-action="Index" asp-route-hiveId="@Model.HiveId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Enable "Delete" only after explicit confirmation
        document.getElementById('confirmCheck')?.addEventListener('change', function () {
            const btn = document.getElementById('deleteBtn');
            if (btn) btn.disabled = !this.checked;
        });
    </script>
}
