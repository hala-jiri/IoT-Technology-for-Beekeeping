@model BeeApp.Shared.ViewModels.HiveInspectionListViewModel

@{
    ViewData["Title"] = "Inspections";

    var total = Model?.Inspections?.Count ?? 0;
    var last = Model?.Inspections?.OrderByDescending(x => x.InspectionDate).FirstOrDefault();

    string Tri(bool? v) => v == true ? "Yes" : v == false ? "No" : "—";
}

<style>
    .subtitle {
        color: #6c757d;
        font-size: .9rem;
    }

    .card-clean {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .kpi-card {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .kpi-title {
        font-size: .85rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: .02em;
    }

    .kpi-value {
        font-size: 1.35rem;
        font-weight: 700;
    }

    .note-trunc {
        max-width: 360px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .w-actions {
        width: 170px;
    }
</style>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">Inspections — Hive: @Model.HiveName</h2>
        <div class="subtitle"><strong>Apiary:</strong> @Model.ApiaryName · <strong>Total:</strong> @total</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" asp-route-hiveId="@Model.HiveId" class="btn btn-success">➕ Add inspection</a>
        <a asp-controller="Hive" asp-action="Detail" asp-route-id="@Model.HiveId" class="btn btn-outline-primary">← Back to hive</a>
    </div>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="kpi-card p-3 h-100">
            <div class="kpi-title mb-1">Last inspection</div>
            <div class="kpi-value mb-1">@(last?.InspectionDate.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
            <div class="subtitle">
                Queen: @Tri(last?.QueenSeen) · Brood: @Tri(last?.BroodPresent)
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="kpi-card p-3 h-100">
            <div class="kpi-title mb-1">Queen seen (all)</div>
            @{
                var qYes = Model.Inspections.Count(x => x.QueenSeen == true);
                var qNo = Model.Inspections.Count(x => x.QueenSeen == false);
                var qNc = Model.Inspections.Count(x => x.QueenSeen == null);
            }
            <div class="kpi-value mb-1">@qYes <span class="subtitle">Yes</span></div>
            <div class="subtitle">No: @qNo · Not checked: @qNc</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="kpi-card p-3 h-100">
            <div class="kpi-title mb-1">Entries</div>
            <div class="kpi-value mb-1">@total</div>
            <div class="subtitle">Latest: @(last?.InspectionDate.ToString("g") ?? "—")</div>
        </div>
    </div>
</div>

@if (Model.Inspections == null || !Model.Inspections.Any())
{
    <div class="alert alert-info">
        No inspections available for this hive yet. Add your first one.
    </div>
}
else
{
    <div class="card card-clean">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:180px;">Date</th>
                            <th>Queen</th>
                            <th>Brood</th>
                            <th>Eggs</th>
                            <th>Pollen</th>
                            <th>Honey</th>
                            <th>Note</th>
                            <th class="w-actions text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Inspections.OrderByDescending(x => x.InspectionDate))
                        {
                            <tr>
                                <td>@i.InspectionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(i.QueenSeen == true ? "✅" : i.QueenSeen == false ? "❌" : "—")</td>
                                <td>@(i.BroodPresent == true ? "✅" : i.BroodPresent == false ? "❌" : "—")</td>
                                <td>@(i.EggsPresent == true ? "✅" : i.EggsPresent == false ? "❌" : "—")</td>
                                <td>@(i.PollenPresent == true ? "✅" : i.PollenPresent == false ? "❌" : "—")</td>
                                <td>@(i.HoneyPresent == true ? "✅" : i.HoneyPresent == false ? "❌" : "—")</td>
                                <td class="note-trunc" title="@i.Notes">@i.Notes</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@i.InspectionReportId" class="btn btn-sm btn-outline-primary">✏️ Edit</a>
                                        <a asp-action="Delete" asp-route-id="@i.InspectionReportId" class="btn btn-sm btn-outline-danger">🗑️ Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
