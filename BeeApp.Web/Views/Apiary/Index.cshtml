@model List<BeeApp.Shared.ViewModels.ApiaryViewModel>

@{
    ViewData["Title"] = "Apiaries";
    var totalApiaries = Model?.Count ?? 0;
    var totalHives = Model?.Sum(a => a.HiveCount) ?? 0;
}

<style>
    .subtitle {
        color: #6c757d;
        font-size: .9rem;
    }

    .toolbar {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        background: #fff;
        padding: .75rem 1rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .apiary-card {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
    }

        .apiary-card .card-body {
            padding: 1rem;
        }
</style>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">Apiaries</h2>
        <div class="subtitle">Total: @totalApiaries · Hives: @totalHives</div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-success">➕ Add Apiary</a>
        <a asp-controller="Seeder" asp-action="Run" class="btn btn-warning">🧪 Seed Fake Data</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        No apiaries yet. Add your first one to get started.
        <a asp-action="Create" class="alert-link">Create Apiary</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var a in Model)
        {
            <div class="col">
                <div class="card apiary-card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-baseline justify-content-between mb-1">
                            <h5 class="card-title mb-0">@a.Name</h5>
                            <span class="badge text-bg-primary">@a.HiveCount @(a.HiveCount == 1 ? "hive" : "hives")</span>
                        </div>
                        <div class="subtitle mb-2">
                            Last measurement:
                            @(a.LastMeasurement?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                        </div>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <a asp-controller="Hive" asp-action="Index" asp-route-apiaryId="@a.ApiaryId" class="btn btn-sm btn-outline-primary">
                                🐝 Hives
                            </a>
                            <a asp-controller="Feeding" asp-action="Dashboard" asp-route-apiaryId="@a.ApiaryId" asp-route-seasonYear="@DateTime.UtcNow.Year" class="btn btn-sm btn-outline-secondary">
                                🍯 Feeding
                            </a>
                            <a asp-action="Edit" asp-route-id="@a.ApiaryId" class="btn btn-sm btn-outline-warning">
                                ✏️ Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@a.ApiaryId" class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Delete apiary &quot;@a.Name&quot;?');">
                                🗑️ Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}