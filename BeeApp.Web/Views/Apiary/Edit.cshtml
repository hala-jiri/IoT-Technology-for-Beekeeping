@model BeeApp.Shared.DTO.ApiaryUpdateDto

@{
    ViewData["Title"] = "Edit Apiary";
}

<style>
    .subtitle {
        color: #6c757d;
        font-size: .9rem;
    }

    .card-clean {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }
</style>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">Edit Apiary</h2>
        <div class="subtitle">ID: @Model.ApiaryId</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-primary">← Back to Apiaries</a>
        <a asp-controller="Hive" asp-action="Index" asp-route-apiaryId="@Model.ApiaryId" class="btn btn-outline-secondary">🐝 View hives</a>
    </div>
</div>

<div class="card card-clean">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ApiaryId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-12 col-md-6">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Hilltop Apiary" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-6 col-md-3">
                <label asp-for="Latitude" class="form-label">Latitude</label>
                <input asp-for="Latitude" id="Latitude" class="form-control" type="number" step="0.000001" lang="en" />
                <span class="subtitle">Click map or drag marker.</span>
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>

            <div class="col-6 col-md-3">
                <label asp-for="Longitude" class="form-label">Longitude</label>
                <input asp-for="Longitude" id="Longitude" class="form-control" type="number" step="0.000001" lang="en" />
                <span class="subtitle">Click map or drag marker.</span>
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label class="form-label">Location on map</label>
                <div id="map" class="rounded" style="height: 360px; width: 100%;"></div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="useGeoloc">📍 Use my location</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="centerFromInputs">Center to inputs</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageFileName))
            {
                <div class="col-12 col-md-6">
                    <label class="form-label">Current image</label>
                    <img src="~/uploads/apiaries/@Model.ImageFileName"
                         class="rounded d-block mb-2"
                         style="max-width: 320px; max-height: 200px; object-fit: cover;" alt="Apiary image" />

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="deleteImage" value="true" id="deleteImage" />
                        <label class="form-check-label" for="deleteImage">❌ Delete current image</label>
                    </div>
                </div>
            }

            <div class="col-12 col-md-6">
                <label class="form-label">Upload new image (optional)</label>
                <input type="file" name="imageFile" class="form-control" id="imageFile" accept="image/*" />
                <div class="subtitle mt-1">JPEG/PNG/WebP · a few MB max.</div>
                <img id="imgPreview" class="rounded mt-2 d-none" style="max-width: 320px; max-height: 200px; object-fit: cover;" alt="Preview" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.3/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"></script>

    <script>
        (function () {
            const latInput = document.getElementById("Latitude");
            const lngInput = document.getElementById("Longitude");

            function parseNum(v, fallback) {
                if (!v) return fallback;
                const n = parseFloat(v.toString().replace(',', '.'));
                return isNaN(n) ? fallback : n;
            }

            const startLat = parseNum(latInput.value, 49.8);
            const startLng = parseNum(lngInput.value, 15.4);

            const map = L.map("map").setView([startLat, startLng], 8);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            let marker = L.marker([startLat, startLng], { draggable: true }).addTo(map);

            function setInputsFromLatLng(pos) {
                latInput.value = pos.lat.toFixed(6);
                lngInput.value = pos.lng.toFixed(6);
            }

            function setMarkerFromInputs() {
                const la = parseNum(latInput.value, NaN);
                const lo = parseNum(lngInput.value, NaN);
                if (!isNaN(la) && !isNaN(lo)) {
                    marker.setLatLng([la, lo]);
                    map.setView([la, lo], map.getZoom());
                }
            }

            map.on("click", e => {
                marker.setLatLng(e.latlng);
                setInputsFromLatLng(e.latlng);
            });

            marker.on("dragend", () => setInputsFromLatLng(marker.getLatLng()));

            document.getElementById("centerFromInputs").addEventListener("click", setMarkerFromInputs);

            // Geolocation helper
            document.getElementById("useGeoloc").addEventListener("click", () => {
                if (!navigator.geolocation) return alert("Geolocation not supported.");
                navigator.geolocation.getCurrentPosition(
                    pos => {
                        const la = pos.coords.latitude, lo = pos.coords.longitude;
                        marker.setLatLng([la, lo]);
                        map.setView([la, lo], 12);
                        setInputsFromLatLng({ lat: la, lng: lo });
                    },
                    err => alert("Cannot get location: " + err.message),
                    { enableHighAccuracy: true, timeout: 8000 }
                );
            });

            // Image preview
            const imgInput = document.getElementById("imageFile");
            const preview = document.getElementById("imgPreview");
            imgInput.addEventListener("change", () => {
                const f = imgInput.files && imgInput.files[0];
                if (!f) { preview.classList.add("d-none"); preview.src = ""; return; }
                const url = URL.createObjectURL(f);
                preview.src = url;
                preview.classList.remove("d-none");
            });

            // Normalize lat/lng on submit (comma -> dot)
            const form = document.querySelector('form[asp-action="Edit"]');
            form.addEventListener('submit', function () {
                if (latInput.value) latInput.value = latInput.value.replace(',', '.');
                if (lngInput.value) lngInput.value = lngInput.value.replace(',', '.');
            });

            setTimeout(() => map.invalidateSize(), 300);
        })();
    </script>
}