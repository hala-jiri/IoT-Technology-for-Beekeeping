@using BeeApp.Shared.ViewModels
@model HomeDashboardViewModel
@{
    ViewData["Title"] = "Home";
}

@if (!Model.DataAvailable && !string.IsNullOrWhiteSpace(Model.SystemMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.SystemMessage
    </div>
}

<section class="mb-3">
    @await Html.PartialAsync("_StatsCards", Model)
</section>

<div class="row">
    <div class="col-lg-7">
        @await Html.PartialAsync("_Alerts", Model)
        <div class="mt-4">
            @await Html.PartialAsync("_RecentEvents", Model)
        </div>
    </div>
    <div class="col-lg-5">
        @await Html.PartialAsync("_QuickActions", Model)
    </div>
</div>