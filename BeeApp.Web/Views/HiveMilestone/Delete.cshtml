@model BeeApp.Shared.Models.HiveMilestone
@using BeeApp.Shared.Helpers

<h2>🗑️ Confirm Deletion</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this milestone?
</div>

<ul>
    <li><strong>Date:</strong> @Model.Date.ToString("yyyy-MM-dd HH:mm")</li>
    <li><strong>Type:</strong> @MilestoneHelper.GetIcon(Model.Type) @Model.Type</li>
    <li><strong>Comment:</strong> @Model.Comment</li>
</ul>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.HiveMilestoneId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" asp-route-hiveId="@Model.HiveId" class="btn btn-secondary">Cancel</a>
</form>