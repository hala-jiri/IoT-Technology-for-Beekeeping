@* ------------------------------ EDIT.cshtml ------------------------------ *@
@model BeeApp.Shared.DTO.HiveMilestoneUpdateDto
@using BeeApp.Shared.Models
@using BeeApp.Shared.Helpers

<h2>✏️ Edit Milestone</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="HiveMilestoneId" />
    <input type="hidden" asp-for="HiveId" />

    <div class="mb-3">
        <label asp-for="Date" class="form-label">Date</label>
        <input asp-for="Date" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="Time" class="form-label">Time</label>
        <input asp-for="Time" class="form-control" type="time" />
    </div>

    <div class="mb-3">
        <label class="form-label">Milestone Type</label>
        @foreach (MilestoneType type in Enum.GetValues(typeof(MilestoneType)))
        {
            <div class="form-check">
                <input class="form-check-input" type="radio" name="Type" value="@type" id="type_@type" checked="@(Model.Type == type)" />
                <label class="form-check-label" for="type_@type">@MilestoneHelper.GetIcon(type) @type</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label asp-for="Comment" class="form-label">Comment</label>
        <textarea asp-for="Comment" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">💾 Save</button>
    <a asp-action="Index" asp-route-hiveId="@Model.HiveId" class="btn btn-secondary">Cancel</a>
</form>

<hr />
